<% const dep = departments.find(x => x.slug === d.department); %>
<article class="doctor-card">
  <a class="doctor-photo" href="<%= url('/doctors/' + d.slug) %>" tabindex="-1" aria-hidden="true">
    <img src="<%= d.photo %>" srcset="<%= srcset(d.photo, [300, 600]) %>" sizes="(max-width: 600px) 90vw, 300px" alt="<%= L(d.name) %>" loading="lazy" width="300" height="350">
  </a>
  <div class="doctor-body">
    <span class="tag"><%= dep ? L(dep.name) : '' %></span>
    <h3><a href="<%= url('/doctors/' + d.slug) %>"><%= L(d.name) %></a></h3>
    <p class="doctor-title"><%= L(d.title) %></p>
    <p class="doctor-meta">
      <span class="rating"><svg class="ic"><use href="#i-star"/></svg><%= d.rating.toFixed(1) %> <small>(<%= d.reviews %> <%= t('common.reviews') %>)</small></span>
      <span><%= d.experience %> <%= t('common.yearsExp') %></span>
    </p>
    <ul class="days" aria-label="<%= t('doctors.availability') %>">
      <% ['sat','sun','mon','tue','wed','thu'].forEach(k => { %><li class="<%= d.days.includes(k) ? 'on' : '' %>"><%= t('day.' + k) %></li><% }) %>
    </ul>
    <a class="btn btn-primary btn-block" href="<%= url('/book?doctor=' + d.slug) %>"><%= t('common.book') %></a>
  </div>
</article>

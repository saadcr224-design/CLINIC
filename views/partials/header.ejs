<%- include('head') %>
<body>
<%- include('icons') %>
<a class="skip-link" href="#main"><%= t('nav.skip') %></a>
<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="<%= site.name %> home">
      <img src="/img/logo.svg" alt="" width="40" height="40">
      <span><strong><%= site.name %></strong><small>Riyadh · Since 2001</small></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <ul>
        <% [['/about', 'nav.about'], ['/departments', 'nav.departments'], ['/doctors', 'nav.doctors'], ['/blog', 'nav.blog'], ['/contact', 'nav.contact']].forEach(([p, k]) => { %>
          <li><a href="<%= p %>"<% if (currentPath.startsWith(p)) { %> aria-current="page"<% } %>><%= t(k) %></a></li>
        <% }) %>
        <li class="has-sub">
          <button type="button" class="sub-toggle" aria-expanded="false"><%= t('nav.more') %></button>
          <ul class="sub">
            <li><a href="/insurance"><%= t('nav.insurance') %></a></li>
            <li><a href="/testimonials"><%= t('nav.testimonials') %></a></li>
            <li><a href="/faq"><%= t('nav.faq') %></a></li>
            <li><a href="/careers"><%= t('nav.careers') %></a></li>
            <li><a href="/portal"><%= t('nav.portal') %></a></li>
          </ul>
        </li>
        <li class="nav-mobile-only"><a href="/insurance"><%= t('nav.insurance') %></a></li>
        <li class="nav-mobile-only"><a href="/testimonials"><%= t('nav.testimonials') %></a></li>
        <li class="nav-mobile-only"><a href="/faq"><%= t('nav.faq') %></a></li>
        <li class="nav-mobile-only"><a href="/careers"><%= t('nav.careers') %></a></li>
        <li class="nav-mobile-only"><a href="/portal"><%= t('nav.portal') %></a></li>
      </ul>
    </nav>
    <div class="header-cta">
      <a class="header-phone" href="tel:<%= site.phone %>"><svg class="ic"><use href="#i-phone"/></svg><span><small>Call us</small><%= site.phoneDisplay %></span></a>
      <button type="button" class="btn btn-emergency btn-sm" data-open="emergency-modal" aria-label="<%= t('emergency.title') %>"><svg class="ic"><use href="#i-ambulance"/></svg><span><%= t('emergency.button') %></span></button>
      <a class="btn btn-primary btn-sm hide-sm-down" href="/book"><%= t('nav.book') %></a>
      <button type="button" class="nav-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="<%= t('nav.menu') %>"><svg class="ic"><use href="#i-menu"/></svg></button>
    </div>
  </div>
</header>
<main id="main" tabindex="-1">

<% const pdep = departments.find(x => x.slug === p.category); %>
<article class="post-card">
  <a href="<%= url('/blog/' + p.slug) %>" class="post-img" tabindex="-1" aria-hidden="true"><img src="<%= p.image %>" srcset="<%= srcset(p.image, [400, 800]) %>" sizes="(max-width: 700px) 90vw, 400px" alt="" loading="lazy" width="400" height="250"></a>
  <div class="post-body">
    <p class="post-meta"><span class="tag"><%= pdep ? L(pdep.name) : '' %></span><time datetime="<%= p.date %>"><%= fmtDate(p.date) %></time></p>
    <h3><a href="<%= url('/blog/' + p.slug) %>"><%= L(p.title) %></a></h3>
    <p><%= L(p.excerpt) %></p>
    <a class="link-arrow" href="<%= url('/blog/' + p.slug) %>"><%= t('common.readMore') %><svg class="ic flip"><use href="#i-arrow"/></svg></a>
  </div>
</article>

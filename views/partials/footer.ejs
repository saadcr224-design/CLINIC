</main>
<section class="newsletter photo-band">
  <img class="band-bg" src="<%= site.images.newsletter %>" srcset="<%= srcset(site.images.newsletter, [800, 1400, 1800]) %>" sizes="100vw" alt="" loading="lazy" decoding="async">
  <div class="container newsletter-inner">
    <div>
      <h2><%= t('newsletter.title') %></h2>
      <p><%= t('newsletter.text') %></p>
    </div>
    <form class="newsletter-form js-form" action="/api/newsletter" method="post" novalidate>
      <label class="sr-only" for="nl-email"><%= t('newsletter.placeholder') %></label>
      <input id="nl-email" type="email" name="email" required autocomplete="email" placeholder="<%= t('newsletter.placeholder') %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-accent" type="submit"><%= t('newsletter.button') %></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo logo-light" href="/"><img src="/img/logo.svg" alt="" width="40" height="40"><span><strong><%= site.name %></strong><small><%= site.tagline %></small></span></a>
      <address>
        <p><svg class="ic"><use href="#i-pin"/></svg><%= site.address %></p>
        <p><svg class="ic"><use href="#i-phone"/></svg><a href="tel:<%= site.phone %>"><%= site.phoneDisplay %></a></p>
        <p><svg class="ic"><use href="#i-mail"/></svg><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      </address>
      <ul class="social">
        <% Object.entries(site.social).forEach(([k, v]) => { %>
          <li><a href="<%= v %>" target="_blank" rel="noopener" aria-label="<%= k %>"><svg class="ic"><use href="#i-<%= k %>"/></svg></a></li>
        <% }) %>
      </ul>
    </div>
    <div>
      <h3><%= t('footer.quick') %></h3>
      <ul>
        <li><a href="/about"><%= t('nav.about') %></a></li>
        <li><a href="/doctors"><%= t('nav.doctors') %></a></li>
        <li><a href="/blog"><%= t('nav.blog') %></a></li>
        <li><a href="/careers"><%= t('nav.careers') %></a></li>
        <li><a href="/contact"><%= t('nav.contact') %></a></li>
      </ul>
    </div>
    <div>
      <h3><%= t('nav.departments') %></h3>
      <ul>
        <% departments.slice(0, 6).forEach(d => { %><li><a href="/departments/<%= d.slug %>"><%= d.name %></a></li><% }) %>
      </ul>
    </div>
    <div>
      <h3><%= t('footer.patients') %></h3>
      <ul>
        <li><a href="/book"><%= t('nav.book') %></a></li>
        <li><a href="/portal"><%= t('nav.portal') %></a></li>
        <li><a href="/insurance"><%= t('nav.insurance') %></a></li>
        <li><a href="/testimonials"><%= t('nav.testimonials') %></a></li>
        <li><a href="/faq"><%= t('nav.faq') %></a></li>
      </ul>
      <h3 class="mt"><%= t('contact.hours') %></h3>
      <ul class="hours">
        <% site.hours.forEach(h => { %><li><span><%= h.days %></span><span><%= h.time %></span></li><% }) %>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© <%= new Date().getFullYear() %> <%= site.name %>. <%= t('footer.rights') %> · <%= t('footer.license') %></p>
    <ul>
      <li><a href="/privacy"><%= t('footer.privacy') %></a></li>
      <li><a href="/terms"><%= t('footer.terms') %></a></li>
      <li><a href="/data-protection"><%= t('footer.dataProtection') %></a></li>
    </ul>
  </div>
</footer>

<div class="fab-stack">
  <a class="fab fab-wa" href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener" aria-label="<%= t('common.whatsapp') %>"><svg class="ic"><use href="#i-whatsapp"/></svg></a>
  <button type="button" class="fab fab-chat" data-open="chat-panel" aria-label="<%= t('chat.open') %>" aria-controls="chat-panel" aria-expanded="false"><svg class="ic"><use href="#i-chat"/></svg></button>
</div>
<nav class="mobile-bar" aria-label="Quick actions">
  <a href="tel:<%= site.phone %>"><svg class="ic"><use href="#i-phone"/></svg>Call</a>
  <a class="primary" href="/book"><svg class="ic"><use href="#i-calendar"/></svg>Book now</a>
  <a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-whatsapp"/></svg>WhatsApp</a>
</nav>

<section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
  <header>
    <div class="chat-avatar"><img src="/img/logo.svg" alt="" width="32" height="32"></div>
    <div><h2 id="chat-title"><%= t('chat.title') %></h2><p><%= t('chat.status') %></p></div>
    <button type="button" class="icon-btn" data-close aria-label="<%= t('common.close') %>"><svg class="ic"><use href="#i-close"/></svg></button>
  </header>
  <div class="chat-log" aria-live="polite">
    <div class="msg bot"><%= t('chat.welcome') %></div>
    <div class="chips">
      <button type="button" data-q="Book an appointment"><%= t('nav.book') %></button>
      <button type="button" data-q="Opening hours"><%= t('contact.hours') %></button>
      <button type="button" data-q="Which insurance do you accept?"><%= t('nav.insurance') %></button>
      <button type="button" data-q="Where are you located?"><%= t('contact.address') %></button>
    </div>
  </div>
  <form class="chat-form">
    <label class="sr-only" for="chat-input"><%= t('chat.placeholder') %></label>
    <input id="chat-input" name="message" maxlength="300" autocomplete="off" placeholder="<%= t('chat.placeholder') %>">
    <button class="btn btn-primary" type="submit"><%= t('chat.send') %></button>
  </form>
  <p class="chat-disclaimer"><%= t('chat.disclaimer') %></p>
</section>

<div class="modal" id="emergency-modal" role="dialog" aria-modal="true" aria-labelledby="em-title" hidden>
  <div class="modal-box">
    <button type="button" class="icon-btn modal-close" data-close aria-label="<%= t('common.close') %>"><svg class="ic"><use href="#i-close"/></svg></button>
    <h2 id="em-title"><svg class="ic"><use href="#i-ambulance"/></svg><%= t('emergency.title') %></h2>
    <p><%= t('emergency.lifeThreat') %></p>
    <a class="btn btn-emergency btn-block btn-xl" href="tel:<%= site.nationalEmergency %>"><svg class="ic"><use href="#i-phone"/></svg><%= site.nationalEmergency %></a>
    <a class="btn btn-outline btn-block" href="tel:<%= site.emergencyPhone %>"><%= t('emergency.callClinic') %> · <%= site.emergencyPhoneDisplay %></a>
    <hr>
    <h3><%= t('emergency.requestAmbulance') %></h3>
    <p class="muted"><%= t('emergency.ambulanceHelp') %></p>
    <form class="js-form ambulance-form" action="/api/ambulance" method="post" novalidate>
      <div class="field"><label for="am-phone"><%= t('common.phone') %> *</label><input id="am-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel"></div>
      <div class="field"><label for="am-name"><%= t('common.name') %> <small>(<%= t('common.optional') %>)</small></label><input id="am-name" name="name" autocomplete="name"></div>
      <input type="hidden" name="lat"><input type="hidden" name="lng">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="button" class="btn btn-outline btn-block js-geo" data-done="<%= t('emergency.locationShared') %>"><svg class="ic"><use href="#i-pin"/></svg><%= t('emergency.shareLocation') %></button>
      <button type="submit" class="btn btn-emergency btn-block"><%= t('emergency.send') %></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>

<script type="application/json" id="app-config"><%- JSON.stringify({
  csrf: csrfToken,
  fallbackImages: site.fallbackImages, fallbackPortraits: site.fallbackPortraits,
  i18n: { sending: t('common.sending'), error: t('common.error'), loadingSlots: t('book.loadingSlots'), noSlots: t('book.noSlots'), pickDate: t('book.pickDate'), anyDoctor: t('book.anyDoctor') }
}).replace(/</g, '\\u003c') %></script>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
<% if (locals.scripts) { scripts.forEach(s => { %><script src="/js/<%= s %>.js?v=<%= assetVersion %>" defer></script><% }) } %>
</body>
</html>

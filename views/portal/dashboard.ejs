<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: t('portal.title'), lead: t('portal.lead'), image: site.images.portal }) %>
<section class="section portal">
  <div class="container">
    <div class="portal-head">
      <div>
        <p class="muted"><%= t('portal.welcome') %></p>
        <h2 class="portal-name"><%= profile.name %></h2>
        <% if (profile.patient) { %><p class="portal-ids"><span>MRN <strong dir="ltr"><%= profile.patient.mrn %></strong></span><span><%= t('book.dob') %> <strong dir="ltr"><%= profile.patient.dob %></strong></span><span><%= 'Blood type' %> <strong dir="ltr"><%= profile.patient.bloodType %></strong></span></p><% } %>
      </div>
      <form method="post" action="<%= url('/portal/logout') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline" type="submit"><%= t('portal.logout') %></button></form>
    </div>
    <div class="portal-grid">
      <section class="card">
        <h2><svg class="ic"><use href="#i-calendar"/></svg><%= t('portal.upcoming') %></h2>
        <% if (!appointments.length) { %><p class="muted"><%= t('portal.noAppointments') %></p><% } %>
        <ul class="appt-list">
          <% appointments.forEach(a => { %>
            <li><div><strong><%= a.doctorInfo ? L(a.doctorInfo.name) : a.doctor %></strong><span><%= fmtDate(a.date) %> · <span dir="ltr"><%= a.time %></span></span></div><span class="status status-<%= a.status %>"><%= a.status %></span></li>
          <% }) %>
        </ul>
        <a class="btn btn-primary" href="<%= url('/book') %>"><%= t('nav.book') %></a>
      </section>
      <% if (profile.patient) { %>
      <section class="card">
        <h2><svg class="ic"><use href="#i-heart"/></svg><%= t('portal.reports') %></h2>
        <table class="table"><tbody>
          <% profile.patient.reports.forEach(r => { %><tr><td dir="ltr"><%= r.date %></td><td><%= r.name %></td><td><%= r.status %></td></tr><% }) %>
        </tbody></table>
      </section>
      <section class="card">
        <h2><svg class="ic"><use href="#i-card"/></svg><%= t('portal.prescriptions') %></h2>
        <table class="table"><tbody>
          <% profile.patient.prescriptions.forEach(p => { %><tr><td dir="ltr"><%= p.date %></td><td><strong><%= p.drug %></strong><br><small><%= p.dose %></small></td><td><%= p.doctor %></td></tr><% }) %>
        </tbody></table>
      </section>
      <% } %>
    </div>
    <p class="small muted"><svg class="ic"><use href="#i-lock"/></svg><%= t('portal.secure') %></p>
  </div>
</section>
<%- include('../partials/footer') %>

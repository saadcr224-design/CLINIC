<%- include('../partials/header') %>
<section class="section auth-section">
  <div class="container auth-grid">
    <form class="card auth-card" method="post" action="<%= url('/portal/login') %>">
      <span class="feature-icon"><svg class="ic"><use href="#i-lock"/></svg></span>
      <h1><%= t('portal.title') %></h1>
      <p class="muted"><%= t('portal.lead') %></p>
      <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label for="p-email"><%= t('portal.username') %></label><input id="p-email" name="email" type="email" required autocomplete="username" dir="ltr"></div>
      <div class="field"><label for="p-pass"><%= t('portal.password') %></label><input id="p-pass" name="password" type="password" required autocomplete="current-password" dir="ltr"></div>
      <button class="btn btn-primary btn-block btn-lg" type="submit"><%= t('portal.loginBtn') %></button>
      <p class="small muted"><svg class="ic"><use href="#i-shield"/></svg><%= t('portal.secure') %></p>
    </form>
    <% if (demo) { %>
    <aside class="card demo-card">
      <h2><%= t('portal.demo') %></h2>
      <p class="small muted">Development mode only. These accounts are not created when NODE_ENV=production.</p>
      <table class="table compact">
        <thead><tr><th>Role</th><th>Email</th><th>Password</th></tr></thead>
        <tbody><% demo.forEach(u => { %><tr><td><%= u.role %></td><td dir="ltr"><code><%= u.email %></code></td><td dir="ltr"><code><%= u.password %></code></td></tr><% }) %></tbody>
      </table>
    </aside>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<body class="admin">
<%- include('../partials/icons') %>
<header class="admin-bar">
  <div class="container admin-bar-inner">
    <a class="logo logo-light" href="/admin"><img src="/img/logo.svg" alt="" width="32" height="32"><span><strong>Staff console</strong></span></a>
    <nav>
      <a href="/admin">Appointments</a>
      <% if (can('messages:read')) { %><a href="/admin/messages">Inbox</a><% } %>
      <% if (can('audit:read')) { %><a href="/admin/audit">Audit log</a><% } %>
      <a href="/cms/">Content (CMS)</a>
      <a href="/" target="_blank">View site ↗</a>
    </nav>
    <form method="post" action="/portal/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="who"><%= user.name %> · <em><%= user.role %></em></span><button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form>
  </div>
</header>
<main id="main" class="admin-main container">

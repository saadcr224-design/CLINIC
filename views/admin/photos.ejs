<%- include('_layout-top') %>
<div class="admin-head">
  <h1>Photo check</h1>
  <p class="integrity ok"><%= photos.length %> photos · <span id="broken-count">0</span> failed</p>
</div>
<p class="muted">Every photo used on the website. Check that each one loads and shows the right subject. To replace one, change its URL in the CMS (or in <code>content/*.json</code>), or upload your own photo.</p>
<div class="photo-grid">
  <% photos.forEach(p => { %>
  <figure>
    <img src="<%= p.src.replace(/w=\d+/, 'w=500') %>" alt="" loading="lazy">
    <figcaption><strong><%= p.where %></strong> <span class="state"></span><code><%= p.src %></code></figcaption>
  </figure>
  <% }) %>
</div>
<%- include('_layout-bottom') %>

<%- include('_layout-top') %>
<div class="admin-head">
  <h1>Audit log</h1>
  <p class="integrity <%= integrity.ok ? 'ok' : 'bad' %>">
    <% if (integrity.ok) { %>✔ Hash chain intact · <%= integrity.total %> entries<% } else { %>✖ Tampering detected at entry <%= integrity.brokenAt %> of <%= integrity.total %><% } %>
  </p>
</div>
<div class="table-wrap"><table class="table compact">
  <thead><tr><th>Time (UTC)</th><th>Actor</th><th>Role</th><th>Action</th><th>Target</th><th>IP</th><th>Hash</th></tr></thead>
  <tbody><% entries.forEach(e => { %><tr><td><%= e.ts.replace('T', ' ').slice(0, 19) %></td><td><%= e.actor %></td><td><%= e.role %></td><td><code><%= e.action %></code></td><td><%= e.target || '' %></td><td><%= e.ip %></td><td><code title="<%= e.hash %>"><%= e.hash.slice(0, 10) %>…</code></td></tr><% }) %></tbody>
</table></div>
<p class="small muted">Showing the latest 300 entries. Ship <code>data/audit.log</code> to your SIEM for long-term retention.</p>
<%- include('_layout-bottom') %>

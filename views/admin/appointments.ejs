<%- include('_layout-top') %>
<div class="admin-head">
  <h1>Appointments <small class="muted"><%= own ? '(your patients)' : '' %></small></h1>
  <form class="admin-filters" method="get">
    <label>Date <input type="date" name="date" value="<%= date %>"></label>
    <label>Status
      <select name="status"><option value="">All</option><% ['confirmed','checked-in','completed','cancelled','no-show'].forEach(s => { %><option<%= status === s ? ' selected' : '' %>><%= s %></option><% }) %></select>
    </label>
    <button class="btn btn-primary btn-sm">Filter</button>
  </form>
</div>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Ref</th><th>Date / time</th><th>Doctor</th><th>Patient</th><th>Contact</th><th>ID</th><th>Insurance</th><th>Type</th><th>Status</th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="9" class="muted">No appointments.</td></tr><% } %>
  <% rows.forEach(a => { const d = doctors.find(x => x.slug === a.doctor); %>
    <tr>
      <td><code><%= a.ref %></code></td>
      <td><%= a.date %> <strong><%= a.time %></strong></td>
      <td><%= d ? d.name.en : a.doctor %></td>
      <td><%= a.patient.name %><% if (a.reason) { %><br><small class="muted"><%= a.reason %></small><% } %></td>
      <td><a href="tel:<%= a.patient.phone %>"><%= a.patient.phone %></a><br><small><%= a.patient.email %></small></td>
      <td><span class="reveal" data-value="<%= a.patient.nationalId %>">••••••<%= a.patient.nationalId.slice(-4) %></span></td>
      <td><%= a.insurance %></td>
      <td><%= a.visitType %></td>
      <td>
        <% if (can('appointments:update')) { %>
        <form method="post" action="/admin/appointments/<%= a.id %>/status" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="status" class="js-autosubmit" aria-label="Status for <%= a.ref %>"><% ['confirmed','checked-in','completed','cancelled','no-show'].forEach(s => { %><option<%= a.status === s ? ' selected' : '' %>><%= s %></option><% }) %></select>
        </form>
        <% } else { %><span class="status status-<%= a.status %>"><%= a.status %></span><% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<p class="small muted">Every view of this page is recorded in the audit log. National ID numbers are masked; click to reveal.</p>
<%- include('_layout-bottom') %>

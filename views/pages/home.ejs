<%- include('../partials/header', { preloadImage: site.images.hero }) %>
<section class="hero">
  <img class="hero-bg" src="<%= site.images.hero %>" srcset="<%= srcset(site.images.hero, [800, 1200, 1800]) %>" sizes="100vw" alt="" fetchpriority="high" decoding="async">
  <div class="container hero-inner">
    <span class="pill"><span class="dot"></span><%= t('home.badge') %></span>
    <h1><%= t('home.heroTitle') %></h1>
    <p class="lead"><%= t('home.heroText') %></p>
    <div class="hero-actions">
      <a class="btn btn-accent btn-lg" href="/book"><svg class="ic"><use href="#i-calendar"/></svg><%= t('nav.book') %></a>
      <a class="btn btn-ghost btn-lg" href="/doctors"><svg class="ic"><use href="#i-search"/></svg><%= t('home.findDoctor') %></a>
    </div>
    <form class="hero-search" action="/doctors" method="get" role="search">
      <label class="sr-only" for="hero-q"><%= t('home.quickSearch') %></label>
      <svg class="ic"><use href="#i-search"/></svg>
      <input id="hero-q" name="q" placeholder="<%= t('home.quickSearch') %>">
      <select name="dept" aria-label="<%= t('doctors.filterSpecialty') %>">
        <option value="">All specialties</option>
        <% departments.forEach(d => { %><option value="<%= d.slug %>"><%= d.name %></option><% }) %>
      </select>
      <button class="btn btn-primary" type="submit"><%= t('home.search') %></button>
    </form>
  </div>
</section>

<section class="quick-info" aria-label="Clinic information">
  <div class="container quick-grid">
    <a class="quick-card emergency" href="tel:<%= site.emergencyPhone %>"><svg class="ic"><use href="#i-ambulance"/></svg><span><strong>24/7 Emergency</strong><%= site.emergencyPhoneDisplay %></span></a>
    <div class="quick-card"><svg class="ic"><use href="#i-clock"/></svg><span><strong><%= site.hours[0].days %></strong><%= site.hours[0].time %></span></div>
    <a class="quick-card" href="<%= site.mapDirections %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-pin"/></svg><span><strong>Al Olaya, Riyadh</strong><%= t('common.directions') %> →</span></a>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Specialties</span><h2><%= t('home.servicesTitle') %></h2><p><%= t('home.servicesText') %></p></div>
      <a class="link-arrow" href="/departments"><%= t('common.viewAll') %><svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid grid-4">
      <% departments.forEach(d => { %>
      <a class="photo-card" href="/departments/<%= d.slug %>">
        <img src="<%= d.image %>" srcset="<%= srcset(d.image, [400, 700]) %>" sizes="(max-width: 640px) 92vw, (max-width: 960px) 46vw, 290px" alt="" loading="lazy" decoding="async" width="400" height="300">
        <span class="photo-card-body">
          <span class="photo-card-icon"><svg class="ic"><use href="#i-<%= d.icon %>"/></svg></span>
          <strong><%= d.name %></strong>
          <small><%= d.summary %></small>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container split">
    <div class="split-media">
      <img src="<%= site.images.why %>" srcset="<%= srcset(site.images.why, [600, 1000, 1200]) %>" sizes="(max-width: 900px) 100vw, 50vw" alt="Doctor consulting with a patient" loading="lazy" decoding="async" width="700" height="525">
      <div class="float-badge"><svg class="ic"><use href="#i-star"/></svg><strong><%= site.stats[3].value %></strong><span><%= site.stats[3].label %></span></div>
    </div>
    <div>
      <span class="eyebrow">Why us</span>
      <h2><%= t('home.whyTitle') %></h2>
      <ul class="features">
        <% [['award', 1], ['calendar', 2], ['shield', 3], ['card', 4]].forEach(([ic, n]) => { %>
        <li><span class="feature-icon"><svg class="ic"><use href="#i-<%= ic %>"/></svg></span><div><h3><%= t('home.why' + n + '.t') %></h3><p><%= t('home.why' + n + '.d') %></p></div></li>
        <% }) %>
      </ul>
      <ul class="badge-row" aria-label="<%= t('home.trust') %>">
        <% site.accreditations.forEach(a => { %><li><svg class="ic"><use href="#i-award"/></svg><%= a.label %></li><% }) %>
      </ul>
    </div>
  </div>
</section>

<section class="stats-band photo-band">
  <img class="band-bg" src="<%= site.images.facility2 %>" srcset="<%= srcset(site.images.facility2, [800, 1400]) %>" sizes="100vw" alt="" loading="lazy" decoding="async">
  <div class="container">
    <ul class="stats">
      <% site.stats.forEach(s => { %><li><strong><%= s.value %></strong><span><%= s.label %></span></li><% }) %>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Our team</span><h2><%= t('home.doctorsTitle') %></h2></div>
      <a class="link-arrow" href="/doctors"><%= t('common.viewAll') %><svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid grid-4">
      <% doctors.forEach(d => { %><%- include('../partials/doctor-card', { d }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Reviews</span><h2><%= t('home.testimonialsTitle') %></h2></div>
      <a class="link-arrow" href="/testimonials"><%= t('common.viewAll') %><svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid grid-3">
      <% testimonials.forEach(r => { %><%- include('../partials/review-card', { r }) %><% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div><span class="eyebrow">Health library</span><h2><%= t('home.blogTitle') %></h2></div>
      <a class="link-arrow" href="/blog"><%= t('common.viewAll') %><svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid grid-3">
      <% posts.forEach(p => { %><%- include('../partials/post-card', { p }) %><% }) %>
    </div>
  </div>
</section>

<section class="cta-band photo-band">
  <img class="band-bg" src="<%= site.images.cta %>" srcset="<%= srcset(site.images.cta, [800, 1400, 1800]) %>" sizes="100vw" alt="" loading="lazy" decoding="async">
  <div class="container cta-inner">
    <div><h2><%= t('home.ctaTitle') %></h2><p><%= t('home.ctaText') %></p></div>
    <div class="cta-actions">
      <a class="btn btn-accent btn-lg" href="/book"><%= t('nav.book') %></a>
      <a class="btn btn-ghost btn-lg" href="tel:<%= site.phone %>"><svg class="ic"><use href="#i-phone"/></svg><%= site.phoneDisplay %></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <span class="eyebrow">Visit us</span>
      <h2><%= t('nav.contact') %></h2>
      <ul class="contact-list">
        <li><svg class="ic"><use href="#i-pin"/></svg><div><strong><%= t('contact.address') %></strong><p><%= site.address %></p></div></li>
        <li><svg class="ic"><use href="#i-phone"/></svg><div><strong><%= t('common.call') %></strong><p><a href="tel:<%= site.phone %>"><%= site.phoneDisplay %></a></p></div></li>
        <li><svg class="ic"><use href="#i-clock"/></svg><div><strong><%= t('contact.hours') %></strong><% site.hours.forEach(h => { %><p><%= h.days %>: <%= h.time %></p><% }) %></div></li>
      </ul>
      <a class="btn btn-outline" href="<%= site.mapDirections %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-pin"/></svg><%= t('common.directions') %></a>
    </div>
    <div class="map-frame">
      <iframe title="<%= site.name %> on Google Maps" src="<%= site.mapEmbed %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: t('contact.title'), lead: t('contact.lead'), image: site.images.contact }) %>
<section class="section">
  <div class="container contact-grid">
    <div class="contact-cards">
      <a class="contact-card" href="tel:<%= site.phone %>"><svg class="ic"><use href="#i-phone"/></svg><div><strong><%= t('common.call') %></strong><span dir="ltr"><%= site.phoneDisplay %></span></div></a>
      <a class="contact-card emergency" href="tel:<%= site.emergencyPhone %>"><svg class="ic"><use href="#i-ambulance"/></svg><div><strong><%= t('contact.emergencyLine') %></strong><span dir="ltr"><%= site.emergencyPhoneDisplay %></span></div></a>
      <a class="contact-card wa" href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-whatsapp"/></svg><div><strong><%= t('common.whatsapp') %></strong><span dir="ltr">+<%= site.whatsapp %></span></div></a>
      <a class="contact-card" href="mailto:<%= site.email %>"><svg class="ic"><use href="#i-mail"/></svg><div><strong><%= t('common.email') %></strong><span><%= site.email %></span></div></a>
      <div class="contact-card"><svg class="ic"><use href="#i-pin"/></svg><div><strong><%= t('contact.address') %></strong><span><%= L(site.address) %></span><a href="<%= site.mapDirections %>" target="_blank" rel="noopener"><%= t('common.directions') %> →</a></div></div>
      <div class="contact-card"><svg class="ic"><use href="#i-clock"/></svg><div><strong><%= t('contact.hours') %></strong><% site.hours.forEach(h => { %><span><%= L(h.days) %>: <%= L(h.time) %></span><% }) %></div></div>
    </div>
    <form class="card js-form" action="/api/contact" method="post" novalidate>
      <h2><%= t('contact.formTitle') %></h2>
      <p class="notice"><svg class="ic"><use href="#i-shield"/></svg><%= t('contact.noMedical') %></p>
      <div class="row-2">
        <div class="field"><label for="c-name"><%= t('common.name') %> *</label><input id="c-name" name="name" required autocomplete="name" maxlength="80"></div>
        <div class="field"><label for="c-email"><%= t('common.email') %> *</label><input id="c-email" name="email" type="email" required autocomplete="email" dir="ltr" maxlength="254"></div>
        <div class="field"><label for="c-phone"><%= t('common.phone') %></label><input id="c-phone" name="phone" type="tel" autocomplete="tel" dir="ltr" maxlength="20"></div>
        <div class="field">
          <label for="c-subject"><%= t('contact.subject') %> *</label>
          <select id="c-subject" name="subject" required>
            <option value="general"><%= t('contact.subjectGeneral') %></option>
            <option value="appointment"><%= t('contact.subjectAppointment') %></option>
            <option value="billing"><%= t('contact.subjectBilling') %></option>
            <option value="feedback"><%= t('contact.subjectFeedback') %></option>
          </select>
        </div>
      </div>
      <div class="field"><label for="c-msg"><%= t('common.message') %> *</label><textarea id="c-msg" name="message" rows="5" required maxlength="2000"></textarea></div>
      <%- include('../partials/captcha', { id: 'c' }) %>
      <button class="btn btn-primary btn-lg" type="submit"><%= t('common.submit') %></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
  <div class="container">
    <div class="map-frame map-wide"><iframe title="<%= L(site.name) %> map" src="<%= site.mapEmbed %>&hl=<%= lang %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
  </div>
</section>
<%- include('../partials/footer') %>

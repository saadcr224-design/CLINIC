<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: t('blog.title'), lead: t('blog.lead') }) %>
<section class="section">
  <div class="container">
    <ul class="pill-links" aria-label="Topics">
      <li><a href="<%= url('/blog') %>"<%= !cat ? ' aria-current="page"' : '' %>><%= t('blog.all') %></a></li>
      <% departments.forEach(d => { %><li><a href="<%= url('/blog?topic=' + d.slug) %>"<%= cat === d.slug ? ' aria-current="page"' : '' %>><%= L(d.name) %></a></li><% }) %>
    </ul>
    <% if (posts.length) { %>
      <div class="grid grid-3"><% posts.forEach(p => { %><%- include('../partials/post-card', { p }) %><% }) %></div>
    <% } else { %><p class="empty">—</p><% } %>
  </div>
</section>
<%- include('../partials/footer') %>

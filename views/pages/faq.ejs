<%- include('../partials/header', { jsonLd: { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: L(f.q), acceptedAnswer: { '@type': 'Answer', text: L(f.a) } })) } }) %>
<%- include('../partials/pagehead', { heading: t('faq.title'), lead: t('faq.lead'), image: site.images.faq }) %>
<section class="section">
  <div class="container narrow">
    <% [...new Set(faqs.map(f => f.category))].forEach(cat => { %>
      <h2 class="faq-cat"><%= t('faq.cat.' + cat) %></h2>
      <div class="accordion">
        <% faqs.filter(f => f.category === cat).forEach(f => { %>
          <details><summary><%= L(f.q) %></summary><p><%= L(f.a) %></p></details>
        <% }) %>
      </div>
    <% }) %>
    <div class="card help-card">
      <p><%= t('faq.lead') %></p>
      <div class="btn-row">
        <button type="button" class="btn btn-primary" data-open="chat-panel"><svg class="ic"><use href="#i-chat"/></svg><%= t('chat.open') %></button>
        <a class="btn btn-outline" href="tel:<%= site.phone %>"><svg class="ic"><use href="#i-phone"/></svg><span dir="ltr"><%= site.phoneDisplay %></span></a>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>

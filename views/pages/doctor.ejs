<% locals.jsonLd = { '@context': 'https://schema.org', '@type': 'Physician', name: doctor.name.en, image: doctor.photo, medicalSpecialty: department ? department.name.en : undefined,
     description: doctor.bio.en, telephone: site.phone, url: site.url + '/doctors/' + doctor.slug,
     aggregateRating: { '@type': 'AggregateRating', ratingValue: doctor.rating, reviewCount: doctor.reviews },
     address: { '@type': 'PostalAddress', streetAddress: site.address.en, addressLocality: 'Riyadh', addressCountry: 'SA' } }; %>
<%- include('../partials/header', { jsonLd: locals.jsonLd }) %>
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="<%= url('/') %>"><%= t('common.home') %></a><span aria-hidden="true">/</span><a href="<%= url('/doctors') %>"><%= t('nav.doctors') %></a><span aria-hidden="true">/</span><span aria-current="page"><%= L(doctor.name) %></span>
    </nav>
  </div>
</section>
<section class="section doctor-profile">
  <div class="container profile-grid">
    <div class="profile-photo">
      <img src="<%= doctor.photo %>" srcset="<%= srcset(doctor.photo, [400, 600]) %>" sizes="(max-width: 800px) 90vw, 380px" alt="<%= L(doctor.name) %>" width="380" height="440">
    </div>
    <div>
      <span class="tag"><%= department ? L(department.name) : '' %></span>
      <h1><%= L(doctor.name) %></h1>
      <p class="doctor-title lg"><%= L(doctor.title) %></p>
      <p class="doctor-meta lg">
        <span class="rating"><svg class="ic"><use href="#i-star"/></svg><%= doctor.rating.toFixed(1) %> <small>(<%= doctor.reviews %> <%= t('common.reviews') %>)</small></span>
        <span><%= doctor.experience %> <%= t('common.yearsExp') %></span>
      </p>
      <dl class="profile-facts">
        <div><dt><%= t('doctors.qualifications') %></dt><dd><%= L(doctor.qualifications) %></dd></div>
        <div><dt><%= t('doctors.languages') %></dt><dd><%= doctor.languages.join(', ') %></dd></div>
        <div><dt><%= t('doctors.availability') %></dt><dd><ul class="days"><% ['sat','sun','mon','tue','wed','thu'].forEach(k => { %><li class="<%= doctor.days.includes(k) ? 'on' : '' %>"><%= t('day.' + k) %></li><% }) %></ul></dd></div>
      </dl>
      <h2><%= t('doctors.about') %></h2>
      <p><%= L(doctor.bio) %></p>
      <% if (doctor.video) { %>
        <h2><%= t('doctors.videoIntro') %></h2>
        <div class="video-frame"><iframe src="<%= doctor.video %>" title="<%= t('doctors.videoIntro') %>" loading="lazy" allowfullscreen></iframe></div>
      <% } %>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href="<%= url('/book?doctor=' + doctor.slug) %>"><svg class="ic"><use href="#i-calendar"/></svg><%= t('doctors.bookWith') %> <%= L(doctor.name) %></a>
        <a class="btn btn-outline btn-lg" href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent((lang === 'ar' ? 'أرغب في حجز موعد مع ' : 'I would like to book with ') + L(doctor.name)) %>" target="_blank" rel="noopener"><svg class="ic"><use href="#i-whatsapp"/></svg><%= t('common.whatsapp') %></a>
      </div>
    </div>
  </div>
</section>
<% if (reviews.length) { %>
<section class="section section-alt">
  <div class="container">
    <h2><%= t('nav.testimonials') %></h2>
    <div class="grid grid-3"><% reviews.forEach(r => { %><%- include('../partials/review-card', { r }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: t('careers.title'), lead: t('careers.lead'), image: site.images.careers }) %>
<section class="section">
  <div class="container">
    <ul class="perks">
      <% [['award', 1], ['shield', 2], ['globe', 3], ['user', 4]].forEach(([ic, n]) => { %><li><span class="feature-icon"><svg class="ic"><use href="#i-<%= ic %>"/></svg></span><%= t('careers.why' + n) %></li><% }) %>
    </ul>
    <h2><%= t('careers.open') %></h2>
    <% if (!jobs.length) { %><p class="empty"><%= t('careers.none') %></p><% } %>
    <div class="jobs">
      <% jobs.forEach(j => { const jd = departments.find(d => d.slug === j.department); %>
        <article class="job-card">
          <div>
            <h3><%= L(j.title) %></h3>
            <p class="job-meta"><span class="tag"><%= jd ? L(jd.name) : (lang === 'ar' ? 'الإدارة' : 'Administration') %></span><span><%= L(j.type) %></span><span><svg class="ic"><use href="#i-pin"/></svg><%= lang === 'ar' ? 'الرياض' : 'Riyadh' %></span></p>
            <p><%= L(j.summary) %></p>
          </div>
          <a class="btn btn-outline js-apply" href="#apply" data-job="<%= j.id %>"><%= t('careers.apply') %></a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<section class="section section-alt" id="apply">
  <div class="container narrow">
    <form class="card js-form" action="/api/careers" method="post" novalidate>
      <h2><%= t('careers.applyTitle') %></h2>
      <div class="field">
        <label for="j-job"><%= t('careers.open') %> *</label>
        <select id="j-job" name="job" required>
          <% jobs.forEach(j => { %><option value="<%= j.id %>"><%= L(j.title) %></option><% }) %>
          <option value="general"><%= lang === 'ar' ? 'طلب عام' : 'General application' %></option>
        </select>
      </div>
      <div class="row-2">
        <div class="field"><label for="j-name"><%= t('common.name') %> *</label><input id="j-name" name="name" required autocomplete="name" maxlength="80"></div>
        <div class="field"><label for="j-email"><%= t('common.email') %> *</label><input id="j-email" name="email" type="email" required autocomplete="email" dir="ltr"></div>
        <div class="field"><label for="j-phone"><%= t('common.phone') %> *</label><input id="j-phone" name="phone" type="tel" required autocomplete="tel" dir="ltr"></div>
        <div class="field"><label for="j-cv"><%= t('careers.cv') %> *</label><input id="j-cv" name="cv" type="url" required placeholder="https://" dir="ltr"></div>
      </div>
      <div class="field"><label for="j-msg"><%= t('common.message') %> <small>(<%= t('common.optional') %>)</small></label><textarea id="j-msg" name="message" rows="3" maxlength="1000"></textarea></div>
      <%- include('../partials/captcha', { id: 'j' }) %>
      <button class="btn btn-primary" type="submit"><%= t('common.submit') %></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>

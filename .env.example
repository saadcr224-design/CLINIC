# Copy to .env (never commit it) or set these in your hosting provider's secret manager.
NODE_ENV=production
PORT=3000
# Number of reverse proxies in front of the app (load balancer / WAF), so client IPs are logged correctly.
TRUST_PROXY=1

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 64 hex chars. Encrypts patient data at rest. Store in a KMS/secret manager and back it up separately.
DATA_KEY=
DATA_DIR=/var/lib/clinic

SESSION_IDLE_MINUTES=15

# Analytics / Search Console (optional)
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# WhatsApp Cloud API (Meta) for confirmations & reminders
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMS via Twilio (or swap the adapter in src/notify.js for Unifonic / Taqnyat)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email: POST {to, subject, text} to your mail relay (SendGrid, SES, ...)
EMAIL_WEBHOOK_URL=
# Staff alerts (ambulance requests, new enquiries), e.g. a Slack/Teams incoming webhook
STAFF_ALERT_WEBHOOK_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/automation (daily reminders)
CRON_SECRET=
